    <ns0:userTask id="Task_RefinarBacklog" name="Refinamiento de Historias y Criterios Gherkin" ns1:formRef="form_05_sprint_planning_dor.form" ns1:formRefBinding="latest" ns1:candidateGroups="Agente: Product Owner AI" />
