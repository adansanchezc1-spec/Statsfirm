<?xml version="1.0" encoding="UTF-8"?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/1.0/bpmn" xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Statsfirm_E2E" targetNamespace="http://statsfirm.co/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <ns0:collaboration id="Collaboration_Statsfirm">
    <ns0:participant id="Participant_Cliente" name="Cliente / Usuario Final (Portal Web &#38; App Móvil Statsfirm)" processRef="Process_Cliente" />
    <ns0:participant id="Participant_Statsfirm" name="Statsfirm Co. — Organización Empresarial &#38; Squads Multidisciplinarios" processRef="Process_Statsfirm" />
    <ns0:messageFlow id="Flow_msg_01" name="Envío Solicitud / Lead Comercial" sourceRef="Task_Cli_Solicitud" targetRef="StartEvent_Lead" />
    <ns0:messageFlow id="Flow_msg_02" name="Insumos de Negocio y Logs" sourceRef="Task_Cli_Discover" targetRef="Task_SesionesDiscover" />
    <ns0:messageFlow id="Flow_msg_03" name="Envío DPA y Contrato para Firma Digital" sourceRef="Task_FormalizarContrato" targetRef="Task_Cli_FirmaContrato" />
    <ns0:messageFlow id="Flow_msg_04" name="Contrato Firmado Digitalmente" sourceRef="Task_Cli_FirmaContrato" targetRef="Task_ActivarERP" />
    <ns0:messageFlow id="Flow_msg_05" name="Demostración de Incremento en Sprint Review" sourceRef="Task_SprintReviewDemo" targetRef="Task_Cli_ReviewSprint" />
    <ns0:messageFlow id="Flow_msg_06" name="Conformidad y Firma Electrónica Avanzada" sourceRef="Task_Cli_FirmaEntrega" targetRef="Task_DispararFactura" />
    <ns0:messageFlow id="Flow_msg_07" name="Reporte de Ticket o Incidencia Técnica" sourceRef="Task_Cli_ReportarIncidente" targetRef="Event_AlertaIncidente" />
  </ns0:collaboration>
  <ns0:process id="Process_Cliente" name="Cliente / Usuario" isExecutable="false">
    <ns0:startEvent id="Start_Cliente" name="Inicio Necesidad Negocio" />
    <ns0:userTask id="Task_Cli_Solicitud" name="Ingresar Necesidad en Portal / App" ns1:formRef="form_01_lead_comercial.form" ns1:formRefBinding="latest" ns1:candidateGroups="Cliente / Usuario" />
    <ns0:userTask id="Task_Cli_Discover" name="Participar en Descubrimiento &#38; Entrevistas" ns1:formRef="form_03_diagnostico_madurez_okrs.form" ns1:formRefBinding="latest" ns1:candidateGroups="Cliente / Usuario" />
    <ns0:userTask id="Task_Cli_FirmaContrato" name="Revisar y Firmar Contrato Digital en App" ns1:formRef="form_04_formalizacion_finops_contrato.form" ns1:formRefBinding="latest" ns1:candidateGroups="Cliente / Representante Legal" />
    <ns0:userTask id="Task_Cli_ReviewSprint" name="Asistir a Sprint Review y Validar DoR/DoD" ns1:formRef="form_08_aprobacion_entrega_firma.form" ns1:formRefBinding="latest" ns1:candidateGroups="Cliente / Product Owner" />
    <ns0:userTask id="Task_Cli_FirmaEntrega" name="Firmar Conformidad de Hito en App" ns1:formRef="form_08_aprobacion_entrega_firma.form" ns1:formRefBinding="latest" ns1:candidateGroups="Cliente / Firmante Autorizado" />
    <ns0:endEvent id="End_Cliente" name="Valor Computable Obtenido" />
    <ns0:userTask id="Task_Cli_ReportarIncidente" name="Reportar Incidente Operativo en Consola" ns1:formRef="form_09_gestion_incidentes_sev.form" ns1:formRefBinding="latest" ns1:candidateGroups="Cliente / Operador de Sistema" />
    <ns0:sequenceFlow id="Flow_cli_1" sourceRef="Start_Cliente" targetRef="Task_Cli_Solicitud" />
    <ns0:sequenceFlow id="Flow_cli_2" sourceRef="Task_Cli_Solicitud" targetRef="Task_Cli_Discover" />
    <ns0:sequenceFlow id="Flow_cli_3" sourceRef="Task_Cli_Discover" targetRef="Task_Cli_FirmaContrato" />
    <ns0:sequenceFlow id="Flow_cli_4" sourceRef="Task_Cli_FirmaContrato" targetRef="Task_Cli_ReviewSprint" />
    <ns0:sequenceFlow id="Flow_cli_5" sourceRef="Task_Cli_ReviewSprint" targetRef="Task_Cli_FirmaEntrega" />
    <ns0:sequenceFlow id="Flow_cli_7" sourceRef="Task_Cli_ReviewSprint" targetRef="Task_Cli_ReportarIncidente" />
    <ns0:sequenceFlow id="Flow_cli_6" sourceRef="Task_Cli_FirmaEntrega" targetRef="End_Cliente" />
  </ns0:process>
  <ns0:process id="Process_Statsfirm" name="Statsfirm Co. - Procesos Integrados" isExecutable="true">
    <ns0:laneSet id="LaneSet_Statsfirm">
      <ns0:lane id="Lane_InnovaLab" name="Agentes de Innova Lab &#38; R&#38;D (AI Agent: Innovation &#38; R&#38;D Accelerator)">
        <ns0:flowNodeRef>Task_RecopilarDORA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_RetrospectivaSquad</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PropuestaAcelerador</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ActualizarMetodologiaSTF</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_MejoraDesplegada</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_OperacionesSRE" name="Agentes SRE &#38; Operaciones 24/7 (AI Agent: SRE On-Call, SecOps &#38; Monitoring)">
        <ns0:flowNodeRef>Task_ClasificarSeveridad</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotificarBoardCISO</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_IncidenteResuelto</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_TelemetriaPrometheus</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_AlertaIncidente</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_MitigacionIncidente</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_EscaladoBoard</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CierreIncidente</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_SoftwareDevOps" name="Agentes de Software, DevOps &#38; QA (AI Agent: Fullstack Dev, Code Review &#38; QA Testing)">
        <ns0:flowNodeRef>Task_DesarrolloGitFlow</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PullRequestReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PipelineCI</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FixCodeQuality</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_SonarPass</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ContinuousDeployProd</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_DoDCertificado</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PruebasQA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DespliegueStaging</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_DataEngineering" name="Agentes de Datos &#38; Gobernanza (AI Agent: Data Engineer &#38; Data Steward)">
        <ns0:flowNodeRef>Task_IngestaBronze</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ValidarEsquema</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_EsquemaBronze</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PersistenciaBronze</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CuraduriaSilver</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_CalidadSilver</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PublicarSemanticBI</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ModeladoGold</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DesvioDLQ</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ValidarGobernanza</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_GestionAgil" name="Agentes de Gestión Ágil &#38; Producto (AI Agent: Product Owner &#38; Agile Coach)">
        <ns0:flowNodeRef>Task_RefinarBacklog</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ClienteConforme</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SetupSquad</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SprintPlanningDoR</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_JoinSprints</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SprintReviewDemo</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_DoRValido</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ForkSprints</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PlanificarAjusteSprint</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_ProcesosARB" name="Agentes de Procesos &#38; Arquitectura ARB (AI Agent: Process Engineer &#38; ARB)">
        <ns0:flowNodeRef>Task_PreEvaluacionViabilidad</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ValidacionARB</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_AprobacionARB</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SesionesDiscover</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ExtraccionLogs</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ProcessMining</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_InformeMadurezOKRs</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_ComercialFinOps" name="Dirección Ejecutiva, FinOps, Legal &#38; RRHH (Roles Humanos: Gerencia, Finanzas, Legal &#38; RRHH)">
        <ns0:flowNodeRef>StartEvent_Lead</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CapturaLead</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_VerificarCRM</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DispararFactura</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_ProyectoCompletado</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_CalificaLead</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotificarRechazoLead</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_LeadRechazado</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ActivarERP</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FormalizarContrato</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_GenerarDPA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ModeladoFinOps</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:scriptTask id="Task_ClasificarSeveridad" name="Clasificación Automatizada (Sev 1 / 2 / 3)">
      <ns0:script>// Execution script</ns0:script>
    </ns0:scriptTask>
    <ns0:sequenceFlow id="sf_56" sourceRef="Event_AlertaIncidente" targetRef="Task_ClasificarSeveridad" />
    <ns0:sequenceFlow id="sf_57" sourceRef="Task_ClasificarSeveridad" targetRef="Task_MitigacionIncidente" />
    <ns0:startEvent id="StartEvent_Lead" name="Recepción de Lead / Contacto Comercial" />
